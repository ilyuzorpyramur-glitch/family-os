# --- Обязательное ---
# Токен для входа в веб-панель и API. Сгенерируйте: openssl rand -base64 24
ADMIN_TOKEN=
# Ключ шифрования токена Zen Money. Сгенерируйте: openssl rand -hex 32
FAMILYOS_SECRET=

# --- Рекомендуемое ---
# Отдельный токен для OpenClaw/MCP (если пусто — используется ADMIN_TOKEN)
AGENT_TOKEN=
# Токен Zen Money с https://zerro.app/token (можно задать позже в UI)
ZENMONEY_TOKEN=
BASE_CURRENCY=PLN
PUBLIC_URL=http://localhost:3001
PORT=3001
TZ=Europe/Warsaw

# --- Локальный запуск без Docker ---
# FAMILYOS_DATA_DIR=./data
# FAMILYOS_DB=./data/familyos.db
# LOG_LEVEL=info
